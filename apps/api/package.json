{
  "name": "@smartedge/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "predev": "npm run build --workspace @smartedge/coordination",
    "build": "npm run build --workspace @smartedge/coordination && tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate.ts",
    "pretest": "npm run build --workspace @smartedge/coordination",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@smartedge/coordination": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
