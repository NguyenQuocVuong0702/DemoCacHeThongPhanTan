# Optional; defaults work without copying this file.
# Set a different project name only when you need a separate PostgreSQL volume.
COMPOSE_PROJECT_NAME=smartedge
DEMO_BOOTSTRAP_TIMEOUT_SECONDS=120
# Compose uses SENSORS_FILE=/app/config/demo-sensors.json inside the simulator.
# For a standalone simulator, omit SENSORS_FILE and keep SENSOR_ID=1 (legacy mode).
